# Copy to .env and edit. 複製成 .env 後修改
WEB_PORT=8080
# Host Ollama (default) 主機 Ollama（預設）
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Docker Ollama (with --profile gpu) 容器 Ollama
# OLLAMA_BASE_URL=http://ollama:11434
ASSISTANT_MODEL=qwen3:8b
DEBATE_MODEL=gemma3:4b
# RAG 檢索 (PostgreSQL + pgvector)
DB_PASSWORD=agent
# keyword = 純關鍵字 (default) | hybrid = 關鍵字 + 向量 (needs: ollama pull bge-m3)
RAG_MODE=keyword
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_DIM=1024
# Reranker 重排序 (also set WITH_RERANK=1): BAAI/bge-reranker-v2-m3 ; empty = off
RAG_RERANKER=
WITH_RERANK=0
